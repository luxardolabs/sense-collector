# E2E stack config (`make test-e2e`, compose profile `e2e`). Committed on purpose:
# every value here is a FIXED TEST value against a throwaway InfluxDB and a fake Sense
# endpoint — none of it is a secret and none of it is reused anywhere real.

TZ=UTC

# --- Throwaway InfluxDB (tmpfs; wiped every run) ---
INFLUX_ORG=sense
INFLUX_BUCKET=sense
INFLUX_TOKEN=sense-e2e-token
INFLUX_USER=sense
INFLUX_PASSWORD=sense-e2e-password

# --- Fake Sense endpoint: a faster, steadier feed than the demo default ---
SENSE_FAKE_MONITOR_ID=12345
SENSE_FAKE_BASE_W=1200
SENSE_FAKE_INTERVAL=1.0

# --- Collector. The fake accepts any credentials; API/WS/InfluxDB URLs are set in
# compose.yaml because they name compose services, not environment. ---
SENSE_COLLECTOR_API_USERNAME=e2e@example.com
SENSE_COLLECTOR_API_PASSWORD=e2e-password
SENSE_COLLECTOR_INFLUXDB_ORG=sense
SENSE_COLLECTOR_INFLUXDB_BUCKET=sense
SENSE_COLLECTOR_INFLUXDB_TOKEN=sense-e2e-token
SENSE_COLLECTOR_MONITOR_STATUS_INTERVAL=30
SENSE_COLLECTOR_OUTPUT_RECEIVED_DATA=False
SENSE_COLLECTOR_LOG_LEVEL_GENERAL=INFO
SENSE_COLLECTOR_LOG_LEVEL_API=INFO
SENSE_COLLECTOR_LOG_LEVEL_STORAGE=INFO
