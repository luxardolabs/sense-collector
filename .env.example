# sense-collector environment template. Copy to .env.dev / .env.prod and fill in.
# .env.dev and .env.prod are gitignored; ONLY this template is committed.
TZ=America/Chicago

# InfluxDB — where energy metrics are written (the fleet's external InfluxDB in prod)
SENSE_COLLECTOR_INFLUXDB_URL=http://influxdb.example.com:8086
SENSE_COLLECTOR_INFLUXDB_ORG=your-org
SENSE_COLLECTOR_INFLUXDB_BUCKET=sense
SENSE_COLLECTOR_INFLUXDB_TOKEN=your-influxdb-token

# Sense account — the cloud API credentials the collector authenticates with
SENSE_COLLECTOR_API_USERNAME=you@example.com
SENSE_COLLECTOR_API_PASSWORD=your-sense-password

# Auth / token renewal
SENSE_COLLECTOR_API_TOKEN_RENEW=43200

# Fetch intervals (seconds)
SENSE_COLLECTOR_MONITOR_STATUS_INTERVAL=60
SENSE_COLLECTOR_DEVICE_LIST_INTERVAL=3600

# WebSocket tuning
SENSE_COLLECTOR_WS_HEARTBEAT_INTERVAL=10
SENSE_COLLECTOR_WS_HEARTBEAT_TIMEOUT=30
SENSE_COLLECTOR_WS_RECONNECT_INTERVAL=840

# Device name cache (respects Sense API rate limits)
SENSE_COLLECTOR_DEVICE_CACHE_EXPIRY_SECONDS=900
SENSE_COLLECTOR_DEVICE_MAX_CONCURRENT_LOOKUPS=4

# Output / raw capture (writes to gitignored output/)
SENSE_COLLECTOR_OUTPUT_RECEIVED_DATA=False
SENSE_COLLECTOR_EXPORT_FOLDER=output

# Log levels: DEBUG | INFO | WARNING | ERROR | CRITICAL
SENSE_COLLECTOR_LOG_LEVEL_GENERAL=INFO
SENSE_COLLECTOR_LOG_LEVEL_API=INFO
SENSE_COLLECTOR_LOG_LEVEL_STORAGE=INFO
