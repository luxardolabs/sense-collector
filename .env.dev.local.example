# Template for .env.dev.local — real Sense account creds for the DEV stack (`make dev-up`).
# Copy to .env.dev.local (gitignored) and fill in. The dev stack layers this over the
# bundled-infra config in .env.demo so it points at a REAL Sense account while still
# writing to the local bundled InfluxDB/Grafana. Without it, use the demo stack (fakes).

# Sense account — required to reach the real Sense cloud API/WebSocket
SENSE_COLLECTOR_API_USERNAME=you@example.com
SENSE_COLLECTOR_API_PASSWORD=your-sense-password
