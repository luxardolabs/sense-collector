# Self-contained DEV/DEMO stack config (compose.dev.yml / compose.demo.yml). Unlike
# .env.dev/.env.prod these are NOT real secrets — they configure a throwaway, local-only
# InfluxDB + Grafana created fresh on `make dev-up` / `make demo-up`. Safe to commit so
# `docker compose up` works out of the box. Do NOT reuse these values anywhere real.

TZ=America/Chicago

# --- Bundled InfluxDB (demo) ---
INFLUX_ORG=sense
INFLUX_BUCKET=sense
INFLUX_TOKEN=sense-collector-demo-token-not-secret
INFLUX_USER=sense
INFLUX_PASSWORD=sensedemo-password

# --- Bundled Grafana (demo) ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Published host ports (override if 3000/8086 are taken on your host).
GRAFANA_PORT=3000
INFLUX_PORT=8086

# --- Collector -> bundled InfluxDB (reached by service name on the bridge network) ---
SENSE_COLLECTOR_INFLUXDB_URL=http://sense_influxdb:8086
SENSE_COLLECTOR_INFLUXDB_ORG=sense
SENSE_COLLECTOR_INFLUXDB_BUCKET=sense
SENSE_COLLECTOR_INFLUXDB_TOKEN=sense-collector-demo-token-not-secret

# --- Sense account ---
# DEV stack: overridden by the gitignored .env.dev.local with your REAL account, so
# the collector streams real Sense data into the bundled InfluxDB.
# DEMO stack: the fake Sense endpoint accepts any credentials, so these dummy values
# are fine (compose.demo.yml also points API/WS at the emulator).
SENSE_COLLECTOR_API_USERNAME=demo@example.com
SENSE_COLLECTOR_API_PASSWORD=demo-password

SENSE_COLLECTOR_OUTPUT_RECEIVED_DATA=False
SENSE_COLLECTOR_EXPORT_FOLDER=output
SENSE_COLLECTOR_HEALTH_CHECK_MAX_AGE=120
SENSE_COLLECTOR_LOG_LEVEL_GENERAL=INFO
SENSE_COLLECTOR_LOG_LEVEL_API=INFO
SENSE_COLLECTOR_LOG_LEVEL_STORAGE=INFO
