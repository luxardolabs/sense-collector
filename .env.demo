# The demo and its config: committed, and NOT secrets. They set up a throwaway, local-only
# InfluxDB + Grafana that `make demo-up` creates fresh (the `demo` profile of compose.yml), fed
# by the fake Sense. Do NOT reuse these values anywhere real: the collector refuses its token
# on any stack that reads the real Sense cloud.

TZ=America/Chicago

# --- Bundled InfluxDB (demo) ---
INFLUX_ORG=sense
INFLUX_BUCKET=sense
INFLUX_TOKEN=sense-collector-demo-token-not-secret
INFLUX_USER=sense
INFLUX_PASSWORD=sensedemo-password
GRAFANA_INFLUX_PASSWORD=sense-demo-grafana-read

# --- Bundled Grafana (demo) ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Published host port for the bundled Grafana (on 127.0.0.1). InfluxDB publishes nothing; it
# is reached by service name on the compose network.
GRAFANA_PORT=13302

# --- Collector -> bundled InfluxDB. The demo profile sets the URL in compose.yml; this value
# is only a fallback for a hand-run container. ---
SENSE_COLLECTOR_INFLUXDB_URL=http://sense_demo_influxdb:8086
SENSE_COLLECTOR_INFLUXDB_ORG=sense
SENSE_COLLECTOR_INFLUXDB_BUCKET=sense
SENSE_COLLECTOR_INFLUXDB_TOKEN=sense-collector-demo-token-not-secret

# --- Sense account: the fake Sense accepts any credentials. ---
SENSE_COLLECTOR_API_USERNAME=demo@example.com
SENSE_COLLECTOR_API_PASSWORD=demo-password

SENSE_COLLECTOR_OUTPUT_RECEIVED_DATA=False
SENSE_COLLECTOR_EXPORT_FOLDER=output
SENSE_COLLECTOR_HEALTH_CHECK_MAX_AGE=120
SENSE_COLLECTOR_LOG_LEVEL_GENERAL=INFO
SENSE_COLLECTOR_LOG_LEVEL_API=INFO
SENSE_COLLECTOR_LOG_LEVEL_STORAGE=INFO
